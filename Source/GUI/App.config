<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <appSettings>
        <!-- Enables the high DPI support of Windows Forms for this (system) DPI-aware application.
             Required for Control.DeviceDpi to report the real system DPI, and for some
             Windows Forms controls to scale their images (e.g. the PropertyGrid toolbar). -->
        <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
    </appSettings>
    <userSettings>
        <My.MySettings>
            <setting name="VisualThemeIndex" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="FontSize" serializeAs="String">
                <value>10</value>
            </setting>
        </My.MySettings>
    </userSettings>
</configuration>
